{
  "compilerOptions": {
    "target": "es2016",
    "lib": [],
    "module": "nodenext",
    "declaration": true,
    "outDir": "./lib",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "lib"]
}
