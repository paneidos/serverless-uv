{
  "name": "serverless-uv",
  "version": "0.0.1",
  "description": "Package Python dependencies for your serverless functions using uv",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": "https://github.com/paneidos/serverless-uv.git",
  "author": "Sernin van de Krol",
  "license": "MIT",
  "keywords": [
    "serverless",
    "serverless-framework",
    "osls",
    "aws",
    "python",
    "uv"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublish": "yarn build",
    "watch": "tsc --project tsconfig.build.json --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/serverless": "^3",
    "osls": "^3",
    "serverless": "^3",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.18.1"
}
